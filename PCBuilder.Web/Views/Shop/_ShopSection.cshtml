@model PCBuilder.Web.ViewModels.Shop.ShopSectionViewModel

@if (Model.Items.Any())
{
    <section class="shop-section mb-5"
             data-shop-section
             data-shop-type="@Model.FilterType"
             data-component-type="@Model.ComponentType">
        <div class="shop-section-header">
            <div>
                <h2 class="shop-section-title">
                    <i class="bi @Model.Icon me-2"></i>@Model.Title
                </h2>
                <p class="text-muted mb-0">@Model.Items.Count() available items</p>
            </div>
            <span class="shop-category-badge align-self-start align-self-md-center">@Model.BadgeText</span>
        </div>

        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                var manufacturerName = item.ManufacturerName?.ToString() ?? string.Empty;
                var itemType = item.GetType().GetProperty("Type")?.GetValue(item)?.ToString() ?? string.Empty;
                decimal price = item.Price ?? 0m;

                <div class="col-12 col-md-6 col-xl-4"
                     data-shop-item
                     data-shop-type="@Model.FilterType"
                     data-component-type="@Model.ComponentType"
                     data-manufacturer="@manufacturerName"
                     data-price="@price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="shop-card h-100">
                        <div class="shop-card-top">
                            <div class="shop-icon-box">
                                <i class="bi @Model.Icon"></i>
                            </div>

                            <span class="shop-category-badge">@Model.Title</span>
                        </div>

                        <div class="shop-card-body">
                            <h5 class="shop-card-title">@item.Name</h5>

                            <div class="shop-brand-badge align-self-start mb-3">
                                <i class="bi bi-award-fill me-1"></i>@manufacturerName
                            </div>

                            @if (!string.IsNullOrWhiteSpace(itemType))
                            {
                                <span class="shop-type-badge align-self-start mb-3">@itemType</span>
                            }

                            <div class="shop-price mt-auto">
                                @price.ToString("N2") kr
                            </div>
                        </div>

                        <div class="shop-card-footer">
                            <button class="btn shop-btn-primary w-100"
                                    type="button"
                                    data-cart-add
                                    data-component-type="@Model.ComponentType"
                                    data-component-id="@item.Id"
                                    data-component-name="@item.Name"
                                    data-purchase-price="@price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <i class="bi bi-cart-plus me-2"></i>Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@model PCBuilder.Web.ViewModels.Shop.ShopSectionViewModel

@if (Model.Items.Any())
{
    <div class="shop-section mb-5">
        <div class="shop-section-header">
            <div>
                <h2 class="shop-section-title">
                    <i class="bi @Model.Icon me-2"></i>@Model.Title
                </h2>
                <p class="text-muted mb-0">@Model.Items.Count() available items</p>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="shop-card h-100">
                        <div class="shop-card-top">
                            <div class="shop-icon-box">
                                <i class="bi @Model.Icon"></i>
                            </div>

                            <span class="shop-category-badge">@Model.Title</span>
                        </div>

                        <div class="shop-card-body">
                            <h5 class="shop-card-title">@item.Name</h5>

                            <div class="shop-price">
                                @item.Price.ToString("N2") kr
                            </div>
                        </div>

                        <div class="shop-card-footer">
                            <form asp-controller="Shop" asp-action="Buy" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="componentType" value="@Model.ComponentType" />
                                <input type="hidden" name="componentId" value="@item.Id" />
                                <input type="hidden" name="purchasePrice" value="@item.Price" />
                                <input type="hidden" name="quantity" value="1" />
                                <button class="btn shop-btn-primary" type="submit">
                                    <i class="bi bi-cart-plus me-2"></i>Buy
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
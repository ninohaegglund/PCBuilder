@model PCBuilder.Web.ViewModels.Shop.ShopSectionViewModel

@if (Model.Items.Any())
{
    <section class="mb-5" data-shop-section data-component-type="@Model.ComponentType">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi @Model.Icon me-2"></i>@Model.Title
                </h2>
                <p class="text-muted mb-0">@Model.Items.Count() available items</p>
            </div>
            <span class="badge text-bg-secondary align-self-start align-self-md-center">@Model.ComponentType</span>
        </div>

        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                var manufacturerName = item.ManufacturerName?.ToString() ?? string.Empty;
                decimal price = item.Price ?? 0m;

                <div class="col-12 col-md-6 col-xl-4"
                     data-shop-item
                     data-component-type="@Model.ComponentType"
                     data-manufacturer="@manufacturerName"
                     data-price="@price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center gap-2">
                            <div class="fs-4 text-primary">
                                <i class="bi @Model.Icon"></i>
                            </div>

                            <span class="badge text-bg-primary">@Model.Title</span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@item.Name</h5>

                            <div class="badge text-bg-light align-self-start mb-3">
                                <i class="bi bi-award-fill me-1"></i>@manufacturerName
                            </div>

                            <div class="fs-4 fw-bold text-success mt-auto">
                                @price.ToString("N2") kr
                            </div>
                        </div>

                        <div class="card-footer bg-transparent">
                            <form asp-controller="Shop" asp-action="Buy" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="componentType" value="@Model.ComponentType" />
                                <input type="hidden" name="componentId" value="@item.Id" />
                                <input type="hidden" name="purchasePrice" value="@price" />
                                <input type="hidden" name="quantity" value="1" />
                                <button class="btn btn-primary w-100" type="submit">
                                    <i class="bi bi-cart-plus me-2"></i>Buy
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

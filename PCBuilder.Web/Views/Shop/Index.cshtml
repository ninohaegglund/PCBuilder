@using PCBuilder.Web.ViewModels.Shop
@model PCBuilder.Web.ViewModels.Shop.ShopViewModel

@{
    var components = Model.Components;

    var cpuCount = components?.Cpus?.Count ?? 0;
    var gpuCount = components?.Gpus?.Count ?? 0;
    var ramCount = components?.Rams?.Count ?? 0;
    var motherboardCount = components?.Motherboards?.Count ?? 0;
    var caseCount = components?.Cases?.Count ?? 0;
    var psuCount = components?.Psus?.Count ?? 0;
    var walletBalanceText = Model.WalletBalance.HasValue
        ? $"{Model.WalletBalance.Value:N2} kr"
        : "N/A";
    var clearSavedCart = TempData["ClearShopCart"] as bool? == true;

    var totalCount =
        cpuCount +
        gpuCount +
        ramCount +
        motherboardCount +
        caseCount +
        psuCount +
        (components?.CpuCoolers?.Count ?? 0) +
        (components?.CaseFans?.Count ?? 0) +
        (components?.InternalStorages?.Count ?? 0) +
        (components?.ExternalStorages?.Count ?? 0) +
        (components?.Monitors?.Count ?? 0) +
        (components?.Keyboards?.Count ?? 0) +
        (components?.Mice?.Count ?? 0) +
        (components?.Headphones?.Count ?? 0) +
        (components?.Speakers?.Count ?? 0);

    var componentTypes = new[]
    {
        ("CPU", "CPUs"),
        ("GPU", "Video Cards"),
        ("RAM", "Memory Kits"),
        ("Motherboard", "Motherboards"),
        ("Case", "Cases"),
        ("PSU", "Power Supplies"),
        ("CPUCooler", "CPU Coolers"),
        ("CaseFan", "Case Fans"),
        ("InternalSSD", "Internal SSDs"),
        ("InternalHDD", "Internal HDDs"),
        ("ExternalSSD", "External SSDs"),
        ("ExternalHDD", "External HDDs"),
        ("Monitor", "Monitors"),
        ("Keyboard", "Keyboards"),
        ("Mouse", "Mice"),
        ("Headphones", "Headphones"),
        ("Speakers", "Speakers")
    };

    IEnumerable<string> GetManufacturerNames(params IEnumerable<dynamic>?[] groups)
    {
        foreach (var group in groups)
        {
            if (group == null) continue;
            foreach (var item in group)
            {
                var value = item?.GetType().GetProperty("ManufacturerName")?.GetValue(item)?.ToString();
                if (!string.IsNullOrWhiteSpace(value))
                {
                    yield return value!;
                }
            }
        }
    }

    decimal GetMaxPrice(params IEnumerable<dynamic>?[] groups)
    {
        var maxPrice = 0m;
        foreach (var group in groups)
        {
            if (group == null) continue;
            foreach (var item in group)
            {
                var rawValue = item?.GetType().GetProperty("Price")?.GetValue(item);
                if (rawValue is decimal price && price > maxPrice)
                {
                    maxPrice = price;
                }
            }
        }
        return Math.Ceiling(maxPrice);
    }

    IEnumerable<dynamic> GetByStorageType(IEnumerable<dynamic>? items, string storageType)
    {
        if (items == null)
        {
            return Enumerable.Empty<dynamic>();
        }

        return items.Where(item =>
        {
            var type = item?.GetType().GetProperty("Type")?.GetValue(item)?.ToString();
            return string.Equals(type, storageType, StringComparison.OrdinalIgnoreCase);
        });
    }

    var internalSsds = GetByStorageType(components?.InternalStorages, "SSD").ToList();
    var internalHdds = GetByStorageType(components?.InternalStorages, "HDD").ToList();
    var externalSsds = GetByStorageType(components?.ExternalStorages, "SSD").ToList();
    var externalHdds = GetByStorageType(components?.ExternalStorages, "HDD").ToList();

    var manufacturers = GetManufacturerNames(
        components?.Cpus,
        components?.Gpus,
        components?.Rams,
        components?.Motherboards,
        components?.Cases,
        components?.Psus,
        components?.CpuCoolers,
        components?.CaseFans,
        components?.InternalStorages,
        components?.ExternalStorages,
        components?.Monitors,
        components?.Keyboards,
        components?.Mice,
        components?.Headphones,
        components?.Speakers)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    var maxPrice = GetMaxPrice(
        components?.Cpus,
        components?.Gpus,
        components?.Rams,
        components?.Motherboards,
        components?.Cases,
        components?.Psus,
        components?.CpuCoolers,
        components?.CaseFans,
        components?.InternalStorages,
        components?.ExternalStorages,
        components?.Monitors,
        components?.Keyboards,
        components?.Mice,
        components?.Headphones,
        components?.Speakers);
}

<div class="container mt-4 mb-5 shop-brite-page">
    <div class="shop-page-shell">
        <div class="shop-page-header text-center">
            <span class="shop-badge">Component Shop</span>
            <h1 class="mb-2">Build Your Stockroom</h1>
            <p class="mb-0 text-muted">
                Buy parts, spend from your wallet, and keep your inventory ready for customer builds.
            </p>
            <div class="shop-page-actions d-flex flex-wrap justify-content-center gap-2 mt-3">
                <button class="btn order-btn order-btn-primary"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#shopCartPanel"
                        aria-controls="shopCartPanel">
                    <i class="bi bi-cart-fill me-2"></i>Cart
                    <span id="shopCartCount" class="badge text-bg-light ms-1">0</span>
                </button>
                <a asp-controller="Inventory" asp-action="Index" class="btn order-btn order-btn-info">
                    <i class="bi bi-box-seam-fill me-2"></i>Inventory
                </a>
            </div>
        </div>

        <div class="shop-page-body">
            <div class="row g-3 mb-4">
                <div class="col-6 col-lg">
                    <div class="shop-stat-card shop-stat-total">
                        <div class="shop-stat-number">@totalCount</div>
                        <div class="shop-stat-label">Total Components</div>
                    </div>
                </div>

                <div class="col-6 col-lg">
                    <div class="shop-stat-card shop-stat-wallet">
                        <div class="shop-stat-number">@walletBalanceText</div>
                        <div class="shop-stat-label">Wallet balance</div>
                    </div>
                </div>

                <div class="col-6 col-lg">
                    <div class="shop-stat-card shop-stat-cpu">
                        <div class="shop-stat-number">@cpuCount</div>
                        <div class="shop-stat-label">CPUs</div>
                    </div>
                </div>

                <div class="col-6 col-lg">
                    <div class="shop-stat-card shop-stat-gpu">
                        <div class="shop-stat-number">@gpuCount</div>
                        <div class="shop-stat-label">GPUs</div>
                    </div>
                </div>

                <div class="col-6 col-lg">
                    <div class="shop-stat-card shop-stat-ram">
                        <div class="shop-stat-number">@ramCount</div>
                        <div class="shop-stat-label">RAM modules</div>
                    </div>
                </div>
            </div>

            <div class="shop-filter-card mb-4">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="shopTypeFilter" class="form-label shop-control-label">Component type</label>
                        <select id="shopTypeFilter" class="form-select playful-input">
                            <option value="">All types</option>
                            @foreach (var type in componentTypes)
                            {
                                <option value="@type.Item1">@type.Item2</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="shopManufacturerFilter" class="form-label shop-control-label">Brand</label>
                        <select id="shopManufacturerFilter" class="form-select playful-input">
                            <option value="">All brands</option>
                            @foreach (var manufacturer in manufacturers)
                            {
                                <option value="@manufacturer">@manufacturer</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <label for="shopPriceFilter" class="form-label shop-control-label mb-0">Max price</label>
                            <span id="shopPriceLabel" class="shop-filter-price">@maxPrice.ToString("N0") kr</span>
                        </div>
                        <input id="shopPriceFilter"
                               class="form-range"
                               type="range"
                               min="0"
                               max="@maxPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               value="@maxPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               step="100" />
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button id="shopFilterReset" type="button" class="btn order-btn order-btn-danger-outline">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reset filters
                    </button>
                    <span id="shopFilterCount" class="shop-filter-count align-self-center">@totalCount items visible</span>
                </div>
            </div>

            @if (components == null || totalCount == 0)
            {
                <div class="empty-shop-state text-center">
                    <i class="bi bi-box-seam display-4 d-block mb-3"></i>
                    <h4>No components found</h4>
                    <p class="text-muted mb-0">There are currently no components available to display.</p>
                </div>
            }
            else
            {
                <partial name="_ShopSection" model='new ShopSectionViewModel("CPUs", "CPU", "bi-cpu", components.Cpus)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Video Cards", "GPU", "bi-gpu-card", components.Gpus)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Memory Kits", "RAM", "bi-memory", components.Rams)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Motherboards", "Motherboard", "bi-motherboard", components.Motherboards)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Cases", "Case", "bi-pc", components.Cases)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Power Supplies", "PSU", "bi-lightning-charge", components.Psus)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("CPU Coolers", "CPUCooler", "bi-fan", components.CpuCoolers)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Case Fans", "CaseFan", "bi-fan", components.CaseFans)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Internal SSDs", "InternalStorage", "bi-device-ssd", internalSsds, "InternalSSD", "Internal Storage / SSD")' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Internal HDDs", "InternalStorage", "bi-device-hdd", internalHdds, "InternalHDD", "Internal Storage / HDD")' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("External SSDs", "ExternalStorage", "bi-device-ssd", externalSsds, "ExternalSSD", "External Storage / SSD")' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("External HDDs", "ExternalStorage", "bi-hdd", externalHdds, "ExternalHDD", "External Storage / HDD")' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Monitors", "Monitor", "bi-display", components.Monitors)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Keyboards", "Keyboard", "bi-keyboard", components.Keyboards)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Mice", "Mouse", "bi-mouse", components.Mice)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Headphones", "Headphones", "bi-headphones", components.Headphones)' />
                <partial name="_ShopSection" model='new ShopSectionViewModel("Speakers", "Speakers", "bi-speaker", components.Speakers)' />
            }
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end shop-cart-panel" tabindex="-1" id="shopCartPanel" aria-labelledby="shopCartPanelLabel">
    <div class="offcanvas-header">
        <div>
            <h5 class="offcanvas-title fw-bold" id="shopCartPanelLabel">
                <i class="bi bi-cart-fill me-2"></i>Shopping Cart
            </h5>
            <small class="text-muted">Buy several components in one checkout</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <div id="shopCartItems" class="vstack gap-2"></div>
        <div id="shopCartEmpty" class="order-text-block">
            Your cart is empty.
        </div>

        <div class="shop-cart-checkout pt-3 mt-auto">
            <div class="d-flex justify-content-between align-items-center fs-5 fw-bold mb-3">
                <span>Total</span>
                <span id="shopCartTotal">0 kr</span>
            </div>

            <form asp-controller="Shop" asp-action="BuyCart" method="post" id="shopCartForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cartJson" id="shopCartJson" />
                <button id="shopCartCheckout" class="btn shop-btn-primary w-100" type="submit" disabled>
                    <i class="bi bi-bag-check-fill me-2"></i>Checkout
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const typeFilter = document.getElementById("shopTypeFilter");
        const manufacturerFilter = document.getElementById("shopManufacturerFilter");
        const priceFilter = document.getElementById("shopPriceFilter");
        const priceLabel = document.getElementById("shopPriceLabel");
        const resetButton = document.getElementById("shopFilterReset");
        const countLabel = document.getElementById("shopFilterCount");
        const shopCartStorageKey = "pcbuilder.shopCart.v1";
        const clearSavedCart = @clearSavedCart.ToString().ToLowerInvariant();

        function loadSavedCart() {
            if (clearSavedCart) {
                localStorage.removeItem(shopCartStorageKey);
                return [];
            }

            try {
                const savedCart = JSON.parse(localStorage.getItem(shopCartStorageKey) || "[]");
                return Array.isArray(savedCart)
                    ? savedCart.filter(function (item) {
                        return item &&
                            item.componentType &&
                            Number(item.componentId) > 0 &&
                            Number(item.purchasePrice) > 0 &&
                            Number(item.quantity) > 0;
                    })
                    : [];
            } catch {
                return [];
            }
        }

        const cart = loadSavedCart();

        function saveCart() {
            localStorage.setItem(shopCartStorageKey, JSON.stringify(cart));
        }

        function applyShopFilters() {
            const selectedType = typeFilter?.value || "";
            const selectedManufacturer = manufacturerFilter?.value || "";
            const maxSelectedPrice = Number(priceFilter?.value || 0);
            let visibleCount = 0;

            document.querySelectorAll("[data-shop-item]").forEach(function (item) {
                const typeMatches = !selectedType || item.dataset.shopType === selectedType;
                const manufacturerMatches = !selectedManufacturer || item.dataset.manufacturer === selectedManufacturer;
                const priceMatches = Number(item.dataset.price || 0) <= maxSelectedPrice;
                const isVisible = typeMatches && manufacturerMatches && priceMatches;

                item.classList.toggle("d-none", !isVisible);
                if (isVisible) {
                    visibleCount += 1;
                }
            });

            document.querySelectorAll("[data-shop-section]").forEach(function (section) {
                const hasVisibleItems = section.querySelectorAll("[data-shop-item]:not(.d-none)").length > 0;
                section.classList.toggle("d-none", !hasVisibleItems);
            });

            if (priceLabel && priceFilter) {
                priceLabel.textContent = Number(priceFilter.value).toLocaleString("sv-SE") + " kr";
            }

            if (countLabel) {
                countLabel.textContent = visibleCount.toLocaleString("sv-SE") + " items visible";
            }
        }

        [typeFilter, manufacturerFilter, priceFilter].forEach(function (element) {
            element?.addEventListener("input", applyShopFilters);
            element?.addEventListener("change", applyShopFilters);
        });

        resetButton?.addEventListener("click", function () {
            if (typeFilter) typeFilter.value = "";
            if (manufacturerFilter) manufacturerFilter.value = "";
            if (priceFilter) priceFilter.value = priceFilter.max;
            applyShopFilters();
        });

        applyShopFilters();

        function renderCart() {
            const cartItems = document.getElementById("shopCartItems");
            const emptyCart = document.getElementById("shopCartEmpty");
            const count = document.getElementById("shopCartCount");
            const total = document.getElementById("shopCartTotal");
            const checkout = document.getElementById("shopCartCheckout");
            const cartJson = document.getElementById("shopCartJson");

            const itemCount = cart.reduce(function (sum, item) {
                return sum + item.quantity;
            }, 0);
            const totalCost = cart.reduce(function (sum, item) {
                return sum + item.purchasePrice * item.quantity;
            }, 0);

            if (count) {
                count.textContent = itemCount.toString();
            }

            if (total) {
                total.textContent = totalCost.toLocaleString("sv-SE", { maximumFractionDigits: 0 }) + " kr";
            }

            if (checkout) {
                checkout.disabled = itemCount === 0;
            }

            if (cartJson) {
                cartJson.value = JSON.stringify(cart);
            }

            saveCart();

            if (!cartItems || !emptyCart) {
                return;
            }

            cartItems.innerHTML = "";
            emptyCart.classList.toggle("d-none", itemCount > 0);

            cart.forEach(function (item) {
                const row = document.createElement("div");
                row.className = "shop-cart-row";

                const body = document.createElement("div");
                body.className = "shop-cart-row-body";

                const top = document.createElement("div");
                top.className = "d-flex justify-content-between gap-2";

                const text = document.createElement("div");
                const name = document.createElement("div");
                name.className = "fw-bold";
                name.textContent = item.name;
                const meta = document.createElement("small");
                meta.className = "text-muted";
                meta.textContent = `${item.componentType} - ${item.purchasePrice.toLocaleString("sv-SE", { maximumFractionDigits: 0 })} kr each`;
                text.appendChild(name);
                text.appendChild(meta);

                const remove = document.createElement("button");
                remove.className = "btn shop-cart-icon-btn shop-cart-remove-btn";
                remove.type = "button";
                remove.innerHTML = '<i class="bi bi-trash"></i>';
                remove.addEventListener("click", function () {
                    const index = cart.findIndex(function (cartItem) {
                        return cartItem.componentType === item.componentType && cartItem.componentId === item.componentId;
                    });
                    if (index >= 0) {
                        cart.splice(index, 1);
                        renderCart();
                    }
                });

                top.appendChild(text);
                top.appendChild(remove);

                const controls = document.createElement("div");
                controls.className = "d-flex align-items-center gap-2 mt-3";

                const minus = document.createElement("button");
                minus.className = "btn shop-cart-icon-btn";
                minus.type = "button";
                minus.textContent = "-";
                minus.addEventListener("click", function () {
                    item.quantity -= 1;
                    if (item.quantity <= 0) {
                        const index = cart.indexOf(item);
                        cart.splice(index, 1);
                    }
                    renderCart();
                });

                const quantity = document.createElement("span");
                quantity.className = "shop-cart-quantity";
                quantity.textContent = item.quantity.toString();

                const plus = document.createElement("button");
                plus.className = "btn shop-cart-icon-btn";
                plus.type = "button";
                plus.textContent = "+";
                plus.addEventListener("click", function () {
                    item.quantity += 1;
                    renderCart();
                });

                const lineTotal = document.createElement("span");
                lineTotal.className = "ms-auto fw-semibold";
                lineTotal.textContent = (item.purchasePrice * item.quantity).toLocaleString("sv-SE", { maximumFractionDigits: 0 }) + " kr";

                controls.appendChild(minus);
                controls.appendChild(quantity);
                controls.appendChild(plus);
                controls.appendChild(lineTotal);

                body.appendChild(top);
                body.appendChild(controls);
                row.appendChild(body);
                cartItems.appendChild(row);
            });
        }

        document.querySelectorAll("[data-cart-add]").forEach(function (button) {
            button.addEventListener("click", function () {
                const componentType = button.dataset.componentType || "";
                const componentId = Number(button.dataset.componentId || 0);
                const existing = cart.find(function (item) {
                    return item.componentType === componentType && item.componentId === componentId;
                });

                if (existing) {
                    existing.quantity += 1;
                } else {
                    cart.push({
                        componentType,
                        componentId,
                        name: button.dataset.componentName || "Component",
                        purchasePrice: Number(button.dataset.purchasePrice || 0),
                        quantity: 1
                    });
                }

                button.classList.remove("shop-btn-primary");
                button.classList.add("shop-btn-added");
                button.innerHTML = '<i class="bi bi-check-lg me-2"></i>Added';
                window.setTimeout(function () {
                    button.classList.remove("shop-btn-added");
                    button.classList.add("shop-btn-primary");
                    button.innerHTML = '<i class="bi bi-cart-plus me-2"></i>Add to Cart';
                }, 900);

                renderCart();
            });
        });

        renderCart();
    </script>
}

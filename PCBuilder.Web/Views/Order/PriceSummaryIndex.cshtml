@using PCBuilder.Services.CustomerAPI.DTO
@using PCBuilder.Web.ViewModels.Computer
@using Contracts
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@model PriceSummaryVM

@{
    var isCompleted = Model.Order.Status == OrderStatus.Completed;
    ViewData["Title"] = isCompleted ? "Order Result" : "Set Sale Price";

    // Hämtas från datorns totalpris
    decimal componentCost = Model.Computer.TotalPrice;

    int defaultMarkup = 50;

    // Första renderingen av sale price
    decimal salePrice = isCompleted && Model.Order.SellingPrice > 0
        ? Model.Order.SellingPrice
        : componentCost * (1 + (defaultMarkup / 100m));

    decimal profit = salePrice - componentCost;
    decimal actualMarkup = componentCost > 0
        ? ((salePrice / componentCost) - 1) * 100
        : 0;
    var summaryColumnClass = isCompleted ? "col-12 col-sm-6 col-xl-3" : "col-12 col-md-4";

    var customerImageUrl = !string.IsNullOrWhiteSpace(Model.Customer?.ImageUrl)
        ? Model.Customer.ImageUrl
        : "/images/customer-placeholder.png";

    var customerName = !string.IsNullOrWhiteSpace(Model.Customer?.Name)
        ? Model.Customer.Name
        : "Customer";

    var showReview = TempData["ShowReview"] as bool? == true
        && string.Equals(Context.Request.Query["review"], "true", StringComparison.OrdinalIgnoreCase);
    ResponseDTO? reviewResponse = null;
    JObject? reviewChecks = null;
    string? reviewText = null;
    var reviewJson = TempData["ReviewResponse"] as string;
    if (string.IsNullOrWhiteSpace(reviewJson) && Model.ReviewResponse != null)
    {
        reviewJson = JsonConvert.SerializeObject(Model.ReviewResponse);
    }
    var reviewLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["GPUFit"] = "Graphics card fit",
        ["Cooling"] = "Cooling and noise",
        ["PSU"] = "Power supply",
        ["Efficiency"] = "Power efficiency",
        ["Budget"] = "Customer budget",
        ["PeripheralRequirements"] = "Requested accessories"
    };

    if (!string.IsNullOrWhiteSpace(reviewJson))
    {
        reviewResponse = JsonConvert.DeserializeObject<ResponseDTO>(reviewJson);
        if (reviewResponse?.Result != null)
        {
            var resultString = reviewResponse.Result as string;
            if (!string.IsNullOrWhiteSpace(resultString) && !resultString.TrimStart().StartsWith("{"))
            {
                reviewText = resultString;
            }
            else
            {
                reviewChecks = reviewResponse.Result switch
                {
                    JObject jObject => jObject,
                    JToken token when token.Type == JTokenType.Object => (JObject)token,
                    string jsonText when !string.IsNullOrWhiteSpace(jsonText) && jsonText.TrimStart().StartsWith("{")
                        => JObject.Parse(jsonText),
                    string errorText => new JObject { ["message"] = errorText },
                    _ => JObject.Parse(JsonConvert.SerializeObject(reviewResponse.Result))
                };
            }
        }
    }
}

<div class="container mt-4 mb-5 price-summary-page">
    @if (!isCompleted)
    {
        <form id="finishBuildForm"
              asp-controller="Order"
              asp-action="FinishBuild"
              method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="orderId" value="@Model.Order.Id" />

            <input type="hidden"
                   id="sellingPriceInput"
                   name="sellingPrice"
                   value="@salePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        </form>
    }

    <div class="orders-page-shell">
        <div class="orders-page-header text-center">
            <span class="orders-badge">Customer Checkout</span>
            <h1 class="mb-2">@(isCompleted ? "Order Result" : "Set Sale Price")</h1>
            <p class="mb-0 text-muted">
                Review the build cost, customer budget, final price, and order outcome.
            </p>
        </div>

        <div class="orders-page-body">
            <div class="row g-4">

                <!-- LEFT SIDE -->
                <div class="col-lg-9">

                    <!-- PRICE OVERVIEW -->
                    <div class="row g-3 mb-4">
                        <div class="@summaryColumnClass">
                            <div class="order-stat-card price-summary-stat price-stat-cost">
                                <div class="price-summary-stat-label">
                                    <i class="bi bi-cpu me-2"></i>Component Cost
                                </div>
                                <div class="order-stat-number">
                                    <span id="componentCost">@Model.Computer.TotalPrice.ToString("N0")</span> kr
                                </div>
                            </div>
                        </div>

                        <div class="@summaryColumnClass">
                            <div class="order-stat-card price-summary-stat price-stat-budget">
                                <div class="price-summary-stat-label">
                                    <i class="bi bi-wallet2 me-2"></i>Customer Budget
                                </div>
                                <div class="order-stat-number">
                                    @Model.Order.Budget.ToString("N0") kr
                                </div>
                            </div>
                        </div>

                        <div class="@summaryColumnClass">
                            <div class="order-stat-card price-summary-stat price-stat-sale">
                                <div class="price-summary-stat-label">
                                    <i class="bi bi-receipt-cutoff me-2"></i>@(isCompleted ? "Final Sale Price" : "Sale Price")
                                </div>
                                <div class="order-stat-number">
                                    <span id="salePrice">@salePrice.ToString("N0")</span> kr
                                </div>
                            </div>
                        </div>

                        @if (isCompleted)
                        {
                            <div class="@summaryColumnClass">
                                <div class="order-stat-card price-summary-stat @(profit >= 0 ? "price-stat-profit" : "price-stat-loss")">
                                    <div class="price-summary-stat-label">
                                        <i class="bi bi-graph-up-arrow me-2"></i>Profit
                                    </div>
                                    <div class="order-stat-number">
                                        @profit.ToString("N0") kr
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

            @if (!isCompleted)
            {
                <!-- SET MARKUP -->
                    <div class="order-card price-summary-panel">
                        <div class="order-card-top">
                            <div>
                                <div class="order-section-label mb-1">
                                    <i class="bi bi-sliders me-2"></i>Sale Controls
                                </div>
                                <h2 class="fw-bold mb-0">Set Markup</h2>
                            </div>
                            <span class="order-status-badge order-status-progress">In Progress</span>
                        </div>

                        <div class="order-card-body">
                            <div class="price-summary-slider-box mb-4">
                                <label for="markupSlider" class="form-label fw-bold fs-5">
                                    Markup:
                                    <span id="markupValue">@defaultMarkup</span>%
                                </label>

                                <input type="range"
                                       class="form-range"
                                       id="markupSlider"
                                       min="0"
                                       max="100"
                                       value="@defaultMarkup" />
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="order-info-box">
                                        <div class="order-info-label">Selected Markup</div>
                                        <div class="order-info-value fs-3">
                                            <span id="markupPreview">@defaultMarkup</span>%
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="order-info-box price-summary-highlight-box">
                                        <div class="order-info-label">Live Sale Price</div>
                                        <div class="order-info-value fs-3">
                                            <span id="salePricePreview">@salePrice.ToString("N0")</span> kr
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="saleBudgetWarning" class="price-summary-warning alert alert-warning rounded-4 mt-3 mb-0 d-none"></div>
                        </div>

                        <div class="order-card-footer">
                            <div class="d-flex flex-column flex-sm-row gap-2">
                                <a asp-controller="Computer"
                                   asp-action="CreateComputerIndex"
                                   asp-route-orderId="@Model.Order.Id"
                                   class="btn order-btn order-btn-info">
                                    <i class="bi bi-tools me-2"></i>Back to Build
                                </a>
                                <button type="submit"
                                        id="finishBuildButton"
                                        form="finishBuildForm"
                                        class="btn order-btn order-btn-success">
                                    <i class="bi bi-check2-circle me-2"></i>Finish Build
                                </button>
                            </div>
                        </div>
                    </div>
            }
            else
            {
                <div class="order-card price-summary-panel">
                    <div class="order-card-top">
                        <div>
                            <div class="order-section-label mb-1">
                                <i class="bi bi-bag-check me-2"></i>Completed Sale
                            </div>
                            <h2 class="fw-bold mb-1">Sale Summary</h2>
                            <p class="text-muted mb-0">Order #@Model.Order.Id is completed.</p>
                        </div>
                        <a href="@Url.Action(isCompleted ? "OrderHistory" : "OrderIndex", "Order")" class="btn order-btn order-btn-primary price-summary-small-action">
                            <i class="bi bi-clock-history me-2"></i>@(isCompleted ? "Back to History" : "Back to Orders")
                        </a>
                    </div>

                    <div class="order-card-body">
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="order-info-box">
                                    <div class="order-info-label">Markup Used</div>
                                    <div class="order-info-value fs-3">@actualMarkup.ToString("N0")%</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="order-info-box">
                                    <div class="order-info-label">Money Spent</div>
                                    <div class="order-info-value fs-3">@componentCost.ToString("N0") kr</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="order-info-box">
                                    <div class="order-info-label">Money Earned</div>
                                    <div class="order-info-value fs-3">@salePrice.ToString("N0") kr</div>
                                </div>
                            </div>
                        </div>

                        <div class="order-section-label fs-4">
                            <i class="bi bi-chat-quote me-2"></i>Customer Review
                        </div>
                        @if (!string.IsNullOrWhiteSpace(reviewText))
                        {
                            <div class="order-text-block mb-0">
                                <h6 class="fw-bold mb-2">@customerName says</h6>
                                <p class="mb-0 fs-5">@reviewText</p>
                            </div>
                        }
                        else if (reviewChecks != null)
                        {
                            <div class="price-summary-review-list">
                                @foreach (var check in reviewChecks.Properties().Where(property => property.Value.Type == JTokenType.Object))
                                {
                                    var checkBody = check.Value as JObject;
                                    var passed = checkBody?["isSuccess"]?.Value<bool>()
                                        ?? checkBody?["IsSuccess"]?.Value<bool>()
                                        ?? false;
                                    var message = checkBody?["message"]?.Value<string>()
                                        ?? checkBody?["Message"]?.Value<string>()
                                        ?? string.Empty;

                                    <div class="order-text-block price-summary-check-row">
                                        <div class="d-flex justify-content-between align-items-start gap-3">
                                            <div>
                                                <h6 class="fw-bold mb-1">@(reviewLabels.TryGetValue(check.Name, out var label) ? label : check.Name)</h6>
                                                <p class="mb-0 text-muted">
                                                    @(string.IsNullOrWhiteSpace(message) ? "No complaints from the customer." : message)
                                                </p>
                                            </div>
                                            <span class="order-status-badge @(passed ? "order-status-completed" : "order-status-pending")">
                                                @(passed ? "Passed" : "Feedback")
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning rounded-4 mb-0">
                                No customer review could be loaded for this order.
                            </div>
                        }
                    </div>
                </div>
            }

        </div>

        <!-- RIGHT SIDE -->
        <div class="col-lg-3">

            <div class="order-card price-summary-side-card h-100">
                <div class="order-card-top">
                    <div>
                        <div class="order-section-label mb-1">
                            <i class="bi bi-person-badge me-2"></i>Current Order
                        </div>
                        <h3 class="fw-bold mb-0">Order #@Model.Order.Id</h3>
                    </div>
                    <span class="order-status-badge @(isCompleted ? "order-status-completed" : "order-status-progress")">
                        @Model.Order.Status
                    </span>
                </div>

                <div class="order-card-body text-center">
                    <img src="@customerImageUrl"
                         class="price-summary-avatar mb-3"
                         alt="@customerName" />

                    <h5 class="fw-bold mb-1">@customerName</h5>
                    <p class="text-muted mb-3">@Model.Order.Description</p>

                    <div class="order-info-box mb-3 text-start">
                        <div class="order-info-label">Budget</div>
                        <div class="order-info-value">@Model.Order.Budget.ToString("N0") kr</div>
                    </div>

                    <div class="order-info-box price-summary-highlight-box text-start">
                        <div class="order-info-label">Current Cost</div>
                        <div class="order-info-value fs-2">@Model.Computer.TotalPrice.ToString("N0") kr</div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
</div>
</div>

@if (showReview && reviewResponse != null)
{
    <div class="modal fade" id="customerReviewModal" tabindex="-1" aria-labelledby="customerReviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content price-summary-modal">
                <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold" id="customerReviewModalLabel">
                                    Customer Review
                                </h5>
                                <div class="small text-muted">
                                    @customerName reviewed order #@Model.Order.Id
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img src="@customerImageUrl"
                             class="price-summary-modal-avatar"
                             alt="@customerName" />
                        <div>
                            <h4 class="fw-bold mb-1">@customerName</h4>
                            <p class="mb-0 text-muted">
                                @(reviewResponse.IsSuccess ? "The customer seems happy with the build." : "The customer had some feedback on the build.")
                            </p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(reviewText))
                    {
                        <div class="order-text-block mb-0">
                            <h6 class="fw-bold mb-2">Customer says</h6>
                            <p class="mb-0 fs-5">@reviewText</p>
                        </div>
                    }
                    else if (reviewChecks != null)
                    {
                        <div class="price-summary-review-list">
                            @foreach (var check in reviewChecks.Properties().Where(property => property.Value.Type == JTokenType.Object))
                            {
                                var checkBody = check.Value as JObject;
                                var passed = checkBody?["isSuccess"]?.Value<bool>()
                                    ?? checkBody?["IsSuccess"]?.Value<bool>()
                                    ?? false;
                                var message = checkBody?["message"]?.Value<string>()
                                    ?? checkBody?["Message"]?.Value<string>()
                                    ?? string.Empty;

                                <div class="order-text-block price-summary-check-row">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <h6 class="fw-bold mb-1">@(reviewLabels.TryGetValue(check.Name, out var label) ? label : check.Name)</h6>
                                            <p class="mb-0 text-muted">
                                                @(string.IsNullOrWhiteSpace(message) ? "No complaints from the customer." : message)
                                            </p>
                                        </div>
                                        <span class="order-status-badge @(passed ? "order-status-completed" : "order-status-pending")">
                                            @(passed ? "Passed" : "Feedback")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning rounded-4 mb-0">
                            @reviewResponse.Message
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <a href="@Url.Action(isCompleted ? "OrderHistory" : "OrderIndex", "Order")" class="btn order-btn order-btn-primary">
                        <i class="bi bi-clock-history me-2"></i>@(isCompleted ? "Back to History" : "Back to Orders")
                    </a>
                    <button type="button" class="btn order-btn order-btn-danger-outline" data-bs-dismiss="modal">
                        Stay Here
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const slider = document.getElementById("markupSlider");

        if (slider) {
            const markupValue = document.getElementById("markupValue");
            const markupPreview = document.getElementById("markupPreview");
            const salePrice = document.getElementById("salePrice");
            const salePricePreview = document.getElementById("salePricePreview");
            const sellingPriceInput = document.getElementById("sellingPriceInput");
            const finishBuildButton = document.getElementById("finishBuildButton");

            const componentCost = Number("@Model.Computer.TotalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)");
            const customerBudget = Number("@Model.Order.Budget.ToString(System.Globalization.CultureInfo.InvariantCulture)");
            const saleBudgetWarning = document.getElementById("saleBudgetWarning");

            function updateSellingPrice() {
                const markup = parseInt(slider.value);

                markupValue.innerText = markup;
                markupPreview.innerText = markup;

                const calculatedPrice = componentCost * (1 + markup / 100);
                const roundedPrice = Math.round(calculatedPrice);

                const formattedPrice = roundedPrice.toLocaleString("sv-SE");

                salePrice.innerText = formattedPrice;
                salePricePreview.innerText = formattedPrice;

                sellingPriceInput.value = roundedPrice.toString();

                if (saleBudgetWarning && customerBudget > 0) {
                    const softLimit = customerBudget * 1.05;
                    const hardLimit = customerBudget * 1.15;

                    if (roundedPrice > hardLimit) {
                        saleBudgetWarning.className = "price-summary-warning alert alert-danger rounded-4 mt-3 mb-0";
                        saleBudgetWarning.textContent = "This sale price is too far over the customer budget. The customer will refuse to pay.";
                    } else if (roundedPrice > softLimit) {
                        saleBudgetWarning.className = "price-summary-warning alert alert-warning rounded-4 mt-3 mb-0";
                        saleBudgetWarning.textContent = "This sale price is a bit over budget. A small stretch can pass, but it is risky.";
                    } else {
                        saleBudgetWarning.className = "price-summary-warning alert alert-warning rounded-4 mt-3 mb-0 d-none";
                        saleBudgetWarning.textContent = "";
                    }

                    if (finishBuildButton) {
                        const customerWillRefuse = roundedPrice > hardLimit;
                        finishBuildButton.disabled = customerWillRefuse;
                        finishBuildButton.classList.toggle("order-btn-success", !customerWillRefuse);
                        finishBuildButton.classList.toggle("order-btn-danger-outline", customerWillRefuse);
                        finishBuildButton.title = customerWillRefuse
                            ? "Lower the price or go back to the build and use cheaper parts."
                            : "";
                    }
                }
            }

            slider.addEventListener("input", updateSellingPrice);
            updateSellingPrice();
        }

        const reviewModalElement = document.getElementById("customerReviewModal");
        if (reviewModalElement) {
            const reviewModal = new bootstrap.Modal(reviewModalElement);
            reviewModal.show();
        }
    </script>


}

@model PCBuilder.Web.ViewModels.Reviews.ReviewsIndexViewModel

@{
    ViewData["Title"] = "Reviews";
    var roundedAverage = Model.CompletedReviewCount > 0
        ? (int)Math.Round(Model.AverageRating, MidpointRounding.AwayFromZero)
        : 0;
}

<div class="container mt-4 mb-5">
    <div class="orders-page-shell">
        <div class="orders-page-header text-center">
            <span class="orders-badge">Customer Reputation</span>
            <h1 class="mb-2">Reviews</h1>
            <p class="mb-0 text-muted">
                Customer feedback, rating history, and workshop reputation.
            </p>
        </div>

        <div class="orders-page-body">
            <div class="card text-bg-primary mb-4">
                <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                    <div>
                        <h2 class="fw-bold mb-2">Average Rating</h2>
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <span class="display-6 fw-bold mb-0">
                                @(Model.CompletedReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "0.0")
                            </span>
                            <span class="review-stars fs-3">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= roundedAverage ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </span>
                        </div>
                        <p class="mb-0 opacity-75">
                            Based on @Model.CompletedReviewCount completed customer reviews.
                        </p>
                    </div>

                    @if (Model.IsGameOver)
                    {
                        <div class="alert alert-danger mb-0">
                            <h5 class="fw-bold mb-1">Game Over</h5>
                            <p class="mb-3">
                                Your average rating became too low, so new customers stopped coming.
                            </p>
                            <form asp-controller="Reviews" asp-action="StartOver" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-light fw-bold" type="submit">
                                    <i class="bi bi-arrow-counterclockwise me-2"></i>Start Over
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>

            @if (!Model.Reviews.Any())
            {
                <div class="empty-orders-state text-center">
                    <i class="bi bi-star display-4 d-block mb-3"></i>
                    <h4>No reviews yet</h4>
                    <p class="text-muted mb-0">Finish customer orders to build your reputation.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var review in Model.Reviews)
                    {
                        var imageUrl = !string.IsNullOrWhiteSpace(review.CustomerImageUrl)
                            ? review.CustomerImageUrl
                            : "/images/customer-placeholder.png";

                        <div class="col-12 col-xl-6">
                            <div class="order-card h-100">
                                <div class="order-card-top">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@imageUrl"
                                             alt="@review.CustomerName"
                                             class="order-customer-avatar" />

                                        <div>
                                            <div class="fw-bold fs-5">@review.CustomerName</div>
                                            <div class="text-muted small">
                                                Order #@review.OrderId
                                            </div>
                                        </div>
                                    </div>

                                    <span class="review-stars">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                        }
                                    </span>
                                </div>

                                <div class="order-card-body">
                                    <div class="mb-3">
                                        <div class="order-section-label">
                                            <i class="bi bi-bag-check me-2"></i>Customer bought
                                        </div>
                                        <div class="order-text-block">
                                            @review.OrderDescription
                                            @if (review.SellingPrice > 0)
                                            {
                                                <span> for @review.SellingPrice.ToString("N0") kr</span>
                                            }
                                        </div>
                                    </div>

                                    <div>
                                        <div class="order-section-label">
                                            <i class="bi bi-chat-quote me-2"></i>Customer says
                                        </div>
                                        <div class="order-text-block order-text-block-detailed">
                                            @review.ReviewText
                                        </div>
                                    </div>
                                </div>

                                <div class="order-card-footer">
                                    <a asp-controller="Order"
                                       asp-action="PriceSummaryIndex"
                                       asp-route-id="@review.OrderId"
                                       class="btn order-btn order-btn-primary">
                                        <i class="bi bi-receipt-cutoff me-2"></i>View Order
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
